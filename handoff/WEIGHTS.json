  "mental_bonus": {
    "_doc": "Big Five 5요인 점수에 따라 누적 적용. N(정서적 안정성)이 가장 결정적.",
    "N": [
      {
        "if": "N < 35",
        "bonus": {
          "일반고": 2.5,
          "자공고2.0": 2.8,
          "자사고": -4,
          "외고": -3.5,
          "국제고": -3.5,
          "과학고": -3.5,
          "영재학교": -4.5
        }
      },
      {
        "if": "N < 50",
        "bonus": {
          "일반고": 1.8,
          "자공고2.0": 2,
          "자사고": -2.8,
          "외고": -2.3,
          "국제고": -2.3,
          "과학고": -2.3,
          "영재학교": -3
        }
      },
      {
        "if": "N < 60",
        "bonus": {
          "일반고": 0.4,
          "자공고2.0": 0.4,
          "자사고": -0.5,
          "영재학교": -0.7
        }
      },
      {
        "if": "N >= 75",
        "bonus": {
          "자사고": 1,
          "영재학교": 1,
          "과학고": 1,
          "외고": 0.5,
          "국제고": 0.5
        }
      }
    ],
    "E": [
      {
        "if": "E >= 65",
        "bonus": {
          "외고": 0.8,
          "국제고": 0.8,
          "자사고": 0.4
        }
      },
      {
        "if": "E < 35",
        "bonus": {
          "일반고": 0.4,
          "자공고2.0": 0.4,
          "과학고": 0.5
        }
      }
    ],
    "C": [
      {
        "if": "C >= 65",
        "bonus": {
          "자사고": 0.6,
          "과학고": 0.7,
          "영재학교": 0.7,
          "외고": 0.4,
          "국제고": 0.4
        }
      },
      {
        "if": "C < 40",
        "bonus": {
          "자사고": -0.8,
          "과학고": -0.8,
          "영재학교": -0.8,
          "일반고": 0.5,
          "자공고2.0": 0.7
        }
      }
    ],
    "O": [
      {
        "if": "O >= 65",
        "bonus": {
          "외고": 0.5,
          "국제고": 0.6,
          "영재학교": 0.5
        }
